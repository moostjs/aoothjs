{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@aooth/user": ["./packages/user/src"],
      "@aooth/user/atscript-db": ["./packages/user/src/atscript-db/index.ts"],
      "arbac-core": ["./packages/arbac-core/src"],
      "@aooth/arbac-moost/atscript": ["./packages/arbac-moost/src/atscript/index.ts"],
      "@aooth/arbac-moost/plugin": ["./packages/arbac-moost/src/plugin.ts"],
      "@aooth/auth-moost/atscript": ["./packages/auth-moost/src/atscript/index.ts"],
      "@aooth/auth/client": ["./packages/auth/src/client/index.ts"],
      "@aooth/*": ["./packages/*/src"]
    }
  }
}
