{
  "name": "@aooth/auth-moost",
  "version": "0.1.11",
  "description": "Moost auth integration for aoothjs — AuthGuard interceptor, useAuth composable, REST endpoints, workflows",
  "keywords": [
    "aoothjs",
    "auth",
    "authentication",
    "guard",
    "interceptor",
    "moost",
    "session",
    "token",
    "workflow"
  ],
  "homepage": "https://github.com/moostjs/aoothjs/tree/main/packages/auth-moost#readme",
  "bugs": {
    "url": "https://github.com/moostjs/aoothjs/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moostjs/aoothjs.git",
    "directory": "packages/auth-moost"
  },
  "files": [
    "dist",
    "src/atscript/models/forms.as",
    "src/atscript/models/forms.as.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./atscript": {
      "types": "./dist/atscript/index.d.mts",
      "import": "./dist/atscript/index.mjs"
    },
    "./atscript/models": {
      "types": "./src/atscript/models/forms.as.d.ts",
      "default": "./src/atscript/models/forms.as"
    },
    "./atscript/models.as": {
      "types": "./src/atscript/models/forms.as.d.ts",
      "default": "./src/atscript/models/forms.as"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:atscript": "asc",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "postinstall": "asc"
  },
  "dependencies": {
    "@aooth/arbac-moost": "workspace:^",
    "@aooth/auth": "workspace:*",
    "@aooth/idp": "workspace:*",
    "@aooth/user": "workspace:*",
    "@atscript/moost-wf": "catalog:",
    "@wooksjs/http-body": "catalog:"
  },
  "devDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/typescript": "catalog:",
    "@atscript/ui": "catalog:",
    "@atscript/ui-fns": "catalog:",
    "@moostjs/event-http": "catalog:",
    "@moostjs/event-wf": "catalog:",
    "moost": "catalog:",
    "unplugin-atscript": "catalog:",
    "wooks": "catalog:"
  },
  "peerDependencies": {
    "@atscript/moost-wf": "catalog:",
    "@atscript/typescript": "catalog:",
    "@moostjs/event-http": "catalog:",
    "@moostjs/event-wf": "catalog:",
    "@wooksjs/event-core": "catalog:",
    "@wooksjs/event-http": "catalog:",
    "@wooksjs/http-body": "catalog:",
    "moost": "catalog:"
  },
  "peerDependenciesMeta": {
    "@atscript/typescript": {
      "optional": true
    }
  }
}
