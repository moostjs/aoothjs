{
  "name": "@aoothjs/auth-moost",
  "version": "0.0.1-alpha.0",
  "description": "Moost auth integration for aoothjs — AuthGuard interceptor, useAuth composable, REST endpoints, workflows",
  "keywords": [
    "aoothjs",
    "auth",
    "authentication",
    "guard",
    "interceptor",
    "moost",
    "session",
    "token",
    "workflow"
  ],
  "homepage": "https://github.com/aoothjs/aoothjs/tree/main/packages/auth-moost#readme",
  "bugs": {
    "url": "https://github.com/aoothjs/aoothjs/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoothjs/aoothjs.git",
    "directory": "packages/auth-moost"
  },
  "files": [
    "dist",
    "src/atscript/models/forms.as",
    "src/atscript/models/forms.as.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./atscript": {
      "types": "./dist/atscript/index.d.mts",
      "import": "./dist/atscript/index.mjs"
    },
    "./atscript/models": "./src/atscript/models/forms.as",
    "./atscript/models.as": "./src/atscript/models/forms.as",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:atscript": "node --experimental-strip-types scripts/gen-as.mjs",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@aoothjs/arbac-moost": "workspace:^",
    "@aoothjs/auth": "workspace:*",
    "@aoothjs/user": "workspace:*",
    "@atscript/moost-wf": "catalog:"
  },
  "devDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/typescript": "catalog:",
    "@atscript/ui": "catalog:",
    "@moostjs/event-http": "catalog:",
    "@moostjs/event-wf": "catalog:",
    "moost": "^0.6.9",
    "unplugin-atscript": "catalog:",
    "wooks": ">=0.7.11"
  },
  "peerDependencies": {
    "@atscript/moost-wf": ">=0.1.58",
    "@atscript/typescript": ">=0.1.54",
    "@moostjs/event-http": ">=0.6.9",
    "@moostjs/event-wf": ">=0.6.9",
    "@wooksjs/event-core": ">=0.7.11",
    "@wooksjs/event-http": ">=0.7.11",
    "moost": ">=0.6.9"
  },
  "peerDependenciesMeta": {
    "@atscript/typescript": {
      "optional": true
    }
  }
}
