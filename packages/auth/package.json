{
  "name": "@aooth/auth",
  "version": "0.1.43",
  "description": "Auth method layer for aoothjs (sessions, tokens, password reset, MFA primitives)",
  "keywords": [
    "aoothjs",
    "auth",
    "authentication",
    "jwt",
    "mfa",
    "password-reset",
    "session",
    "token"
  ],
  "homepage": "https://github.com/moostjs/aoothjs/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/moostjs/aoothjs/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moostjs/aoothjs.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist",
    "src/atscript-db/auth-credential.as",
    "src/atscript-db/auth-credential.as.d.ts",
    "src/atscript-db/pending-authorization.as",
    "src/atscript-db/pending-authorization.as.d.ts",
    "src/atscript-db/auth-code.as",
    "src/atscript-db/auth-code.as.d.ts",
    "src/atscript-db/dynamic-client.as",
    "src/atscript-db/dynamic-client.as.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./redis": {
      "types": "./dist/redis.d.mts",
      "import": "./dist/redis.mjs",
      "require": "./dist/redis.cjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./authz": {
      "types": "./dist/authz.d.mts",
      "import": "./dist/authz.mjs",
      "require": "./dist/authz.cjs"
    },
    "./atscript-db": {
      "types": "./dist/atscript-db.d.mts",
      "import": "./dist/atscript-db.mjs",
      "require": "./dist/atscript-db.cjs"
    },
    "./atscript-db/model": {
      "types": "./src/atscript-db/auth-credential.as.d.ts",
      "default": "./src/atscript-db/auth-credential.as"
    },
    "./atscript-db/model.as": {
      "types": "./src/atscript-db/auth-credential.as.d.ts",
      "default": "./src/atscript-db/auth-credential.as"
    },
    "./atscript-db/pending-authorization": {
      "types": "./src/atscript-db/pending-authorization.as.d.ts",
      "default": "./src/atscript-db/pending-authorization.as"
    },
    "./atscript-db/pending-authorization.as": {
      "types": "./src/atscript-db/pending-authorization.as.d.ts",
      "default": "./src/atscript-db/pending-authorization.as"
    },
    "./atscript-db/auth-code": {
      "types": "./src/atscript-db/auth-code.as.d.ts",
      "default": "./src/atscript-db/auth-code.as"
    },
    "./atscript-db/auth-code.as": {
      "types": "./src/atscript-db/auth-code.as.d.ts",
      "default": "./src/atscript-db/auth-code.as"
    },
    "./atscript-db/dynamic-client": {
      "types": "./src/atscript-db/dynamic-client.as.d.ts",
      "default": "./src/atscript-db/dynamic-client.as"
    },
    "./atscript-db/dynamic-client.as": {
      "types": "./src/atscript-db/dynamic-client.as.d.ts",
      "default": "./src/atscript-db/dynamic-client.as"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "gen:atscript": "asc",
    "prepare": "asc"
  },
  "dependencies": {
    "@aooth/user": "workspace:*",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/db": "catalog:",
    "@atscript/db-sql-tools": "catalog:",
    "@atscript/db-sqlite": "catalog:",
    "@atscript/typescript": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "unplugin-atscript": "catalog:"
  },
  "peerDependencies": {
    "@atscript/db": ">=0.1.79"
  },
  "peerDependenciesMeta": {
    "@atscript/db": {
      "optional": true
    }
  }
}
