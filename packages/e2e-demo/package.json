    "@aooth/auth-moost": "workspace:*",
    "@aooth/idp": "workspace:*",
    "@aooth/login-client": "workspace:*",
    "@aooth/user": "workspace:*",
    "@atscript/core": "catalog:",
    "@atscript/db": "catalog:",
    "@atscript/db-sql-tools": "catalog:",
    "@atscript/db-sqlite": "catalog:",
    "@atscript/moost-db": "catalog:",
    "@atscript/moost-wf": "catalog:",
    "@atscript/typescript": "catalog:",
    "@atscript/ui": "catalog:",
    "@atscript/ui-fns": "catalog:",
    "@atscript/ui-styles": "catalog:",
    "@atscript/vue-aooth": "catalog:",
    "@atscript/vue-form": "catalog:",
    "@atscript/vue-wf": "catalog:",
    "@moostjs/event-http": "catalog:",
    "@moostjs/event-wf": "catalog:",
    "@moostjs/vite": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@uniqu/core": "^0.1.6",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "@wooksjs/event-core": "catalog:",
    "@wooksjs/event-http": "catalog:",
    "better-sqlite3": "^12.6.2",
    "moost": "catalog:",
    "qrcode": "^1.5.4",
    "unocss": "^66.6.8",
    "vue": "catalog:",
    "vue-router": "^4.5.0",
    "vunor": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.84",
    "@playwright/test": "^1.55.0",
    "@types/node": "catalog:",
    "@unocss/vite": "^66.6.8",
