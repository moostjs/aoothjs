{
  "name": "@aooth/e2e-demo",
  "version": "0.1.32",
  "private": true,
  "description": "End-to-end test harness for @aooth/* packages",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite-node --watch src/main.ts",
    "build": "vite build",
    "start": "vite-node src/main.ts",
    "test": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "vp check",
    "gen:atscript": "asc",
    "db:init": "vite-node src/scripts/init-db.ts",
    "postinstall": "asc"
  },
  "dependencies": {
    "@aooth/arbac": "workspace:*",
