{
  "name": "@aooth/e2e-demo",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end test harness for @aooth/* packages",
  "type": "module",
  "scripts": {
    "dev": "vite-node --watch src/main.ts",
    "start": "vite-node src/main.ts",
    "test": "vp test",
    "check": "vp check",
    "gen:atscript": "asc -f dts",
    "db:init": "vite-node src/scripts/init-db.ts"
  },
  "dependencies": {
    "@aooth/arbac": "workspace:*",
    "@aooth/arbac-core": "workspace:*",
    "@aooth/arbac-moost": "workspace:*",
    "@aooth/auth": "workspace:*",
    "@aooth/auth-moost": "workspace:*",
    "@aooth/user": "workspace:*",
    "@atscript/core": "catalog:",
    "@atscript/db": "catalog:",
    "@atscript/db-sql-tools": "catalog:",
    "@atscript/db-sqlite": "catalog:",
    "@atscript/moost-db": "catalog:",
    "@atscript/moost-wf": "catalog:",
    "@atscript/typescript": "catalog:",
    "@atscript/ui": "catalog:",
    "@moostjs/event-http": "catalog:",
    "@moostjs/event-wf": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@uniqu/core": "^0.1.6",
    "@wooksjs/event-core": "catalog:",
    "@wooksjs/event-http": "catalog:",
    "better-sqlite3": "^12.6.2",
    "moost": "catalog:"
  },
  "devDependencies": {
    "unplugin-atscript": "catalog:",
    "vite-node": "^3.0.0",
    "vite-plus": "catalog:"
  }
}
