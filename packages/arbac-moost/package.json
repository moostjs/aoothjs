{
  "name": "@aoothjs/arbac-moost",
  "version": "0.0.1-alpha.0",
  "description": "Moost RBAC integration for aoothjs (migrated from @moostjs/arbac)",
  "keywords": [
    "abac",
    "access-control",
    "aoothjs",
    "arbac",
    "authorization",
    "moost",
    "permissions",
    "rbac"
  ],
  "homepage": "https://github.com/aoothjs/aoothjs/tree/main/packages/arbac-moost#readme",
  "bugs": {
    "url": "https://github.com/aoothjs/aoothjs/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoothjs/aoothjs.git",
    "directory": "packages/arbac-moost"
  },
  "files": [
    "dist",
    "src/atscript/models/user.as",
    "src/atscript/models/user.as.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./atscript": {
      "types": "./dist/atscript/index.d.mts",
      "import": "./dist/atscript/index.mjs"
    },
    "./atscript/models": "./src/atscript/models/user.as",
    "./atscript/models.as": "./src/atscript/models/user.as",
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:atscript": "node --experimental-strip-types scripts/gen-as.mjs",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@aoothjs/arbac": "workspace:*",
    "@aoothjs/arbac-core": "workspace:*",
    "@aoothjs/user-as": "workspace:*"
  },
  "devDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/db": "catalog:",
    "@atscript/db-sql-tools": "catalog:",
    "@atscript/db-sqlite": "catalog:",
    "@atscript/moost-db": "catalog:",
    "@atscript/typescript": "catalog:",
    "@moostjs/event-http": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@uniqu/core": "^0.1.6",
    "better-sqlite3": "^12.6.2",
    "unplugin-atscript": "catalog:"
  },
  "peerDependencies": {
    "@atscript/db": ">=0.1.78",
    "@atscript/moost-db": ">=0.1.78",
    "@atscript/typescript": ">=0.1.54",
    "@moostjs/event-http": ">=0.6.9",
    "@wooksjs/event-core": ">=0.7.11",
    "@wooksjs/event-http": ">=0.7.11",
    "moost": ">=0.6.9"
  },
  "peerDependenciesMeta": {
    "@atscript/db": {
      "optional": true
    },
    "@atscript/moost-db": {
      "optional": true
    },
    "@atscript/typescript": {
      "optional": true
    }
  }
}
