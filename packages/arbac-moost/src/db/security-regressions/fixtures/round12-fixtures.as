// Fixtures for the round-12 specs: dictionary bindings (`test.valueHelp`
// stands in for the `ui.valueHelp` key), `@DbDecorations` hosts, aggregate
// expressions / first-last, id aliases and insert-ignore.

@db.table 'r12_dicts'
export interface R12Dict {
    @meta.id
    id: number

    code: string

    label: string

    secretCode: string

    region: string
}

@db.table 'r12_items'
export interface R12Item {
    @meta.id
    id: number

    owner: string

    status: string

    rank: number

    createdAt: number

    @ui.valueHelp R12Dict, 'code', `region = 'eu'`
    color?: string

    @ui.valueHelp R12Dict, 'secretCode'
    pinned?: string

    @ui.valueHelp R12Dict, 'code', `secretCode = 'x'`
    filtered?: string

    @db.rel.FK
    dictId?: R12Dict.id

    @db.rel.to
    dict?: R12Dict

    ownerId?: number
}

// Display-only decorations of R12Item (a plain interface).
export interface R12Decorations {
    @meta.label 'Owner'
    ownerName?: string
}

// A form (served by `/meta/form/:name`) pointing at the dictionary.
export interface R12DictForm {
    @ui.valueHelp R12Dict, 'code', `region = 'eu'`
    color?: string

    @ui.valueHelp R12Dict, 'secretCode'
    pinned?: string

    dictId?: R12Dict.id

    note: string
}

@db.table 'r12_codes'
export interface R12Code {
    // Generated by the database when a row omits it.
    @meta.id
    @db.default.increment
    id: number

    @db.index.unique 'r12_code_idx'
    code: string

    tenant: string

    title: string
}
